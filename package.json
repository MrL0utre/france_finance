{
  "name": "finance-france",
  "private": true,
  "version": "1.0.0",
  "description": "Explorateur et simulateur des finances publiques françaises, de l'État à la commune",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "test": "tsx tests/simulation.test.ts && tsx tests/partage.test.ts && tsx tests/modeles.test.ts && tsx tests/dette.test.ts && tsx tests/bareme.test.ts && tsx tests/trajectoire.test.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:build": "tsx pipeline/build.ts",
    "data:build:force": "tsx pipeline/build.ts --force"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "^5.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
